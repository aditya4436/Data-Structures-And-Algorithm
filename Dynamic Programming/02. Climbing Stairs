// Time Complexity: O(n)
//Space Complexity: O(1)
class Solution {
public:
    int climbStairs(int n) {
        int prev1 = 1, prev2 = 1;

        for(int i = 2; i <= n; i++){
            int ans = prev1 + prev2;
            prev1 = prev2;
            prev2 = ans;
        }

        return prev2;
    }
};


// Time Complexity: O(n)
// Space Complexity: O(n) + O(n) recursion stack space
class Solution {
public:
    int climbStairs(int n) {
        vector<int> dp(n + 1, -1);
        if(n == 0 || n == 1) return 1;

        if(dp[n] != -1){
            return dp[n];
        }

        return dp[n] = climbStairs(n - 1) + climbStairs(n - 2);
    }
};

// Time Complexity: O(2^nn)
// Space Complexity: O(n) recursion stack space
class Solution {
public:
    int climbStairs(int n) {
        if(n == 1 || n == 0) return 1;

        int left = climbStairs(n - 1);
        int right = climbStairs(n - 2);

        return left + right;
    }
};
